{
  "name": "astrological-file-interceptor",
  "version": "1.0.0",
  "private": true,
  "description": "A satirical Astrological File Interceptor dashboard monolithic application",
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:client": "vite --config client/vite.config.js client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build client --config client/vite.config.js",
    "build": "npm run build:client",
    "start": "node server/server.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
